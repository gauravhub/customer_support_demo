{
    "openapi": "3.1.0",
    "info": {
        "title": "Issue Management API",
        "description": "REST API for managing JIRA issues (X-API-Key header required)",
        "version": "0.1.0"
    },
    "servers": [
        {
            "url": "https://YOUR_CLOUDFRONT_DOMAIN.cloudfront.net/issue-management",
            "description": "Issue Management API Server (CloudFront HTTPS endpoint)"
        }
    ],
    "paths": {
        "/api/issue/{issue_key}": {
            "get": {
                "summary": "Get Issue",
                "description": "Get issue information by issue key.\n\nArgs:\n    issue_key: JIRA issue key (e.g., \"AS-5\", \"PROJ-123\")\n\nReturns:\n    Dictionary with issue information if found, empty dict if not found.\n    Contains: key, summary, description, status, assignee, reporter, etc.",
                "operationId": "get_issue_api_issue__issue_key__get",
                "parameters": [
                    {
                        "name": "issue_key",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Issue Key"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "additionalProperties": true,
                                    "title": "Response Get Issue Api Issue  Issue Key  Get"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/issue/{issue_key}/field": {
            "get": {
                "summary": "Get Issue Field",
                "description": "Get a specific field value from an issue.\n\nArgs:\n    issue_key: JIRA issue key (e.g., \"AS-5\")\n    field_name: Field name to retrieve (e.g., \"reporter\", \"customfield_10071\")\n\nReturns:\n    Dictionary with field value if found, empty dict if not found.",
                "operationId": "get_issue_field_api_issue__issue_key__field_get",
                "parameters": [
                    {
                        "name": "issue_key",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Issue Key"
                        }
                    },
                    {
                        "name": "field_name",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "description": "Field name (e.g., 'reporter', 'customfield_10071')",
                            "title": "Field Name"
                        },
                        "description": "Field name (e.g., 'reporter', 'customfield_10071')"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "additionalProperties": true,
                                    "title": "Response Get Issue Field Api Issue  Issue Key  Field Get"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            },
            "put": {
                "summary": "Update Issue Field",
                "description": "Update a field value in an issue.\n\nArgs:\n    issue_key: JIRA issue key (e.g., \"AS-5\")\n    request: Request body with field_name and value\n\nReturns:\n    Dictionary with success status\n\nNote:\n    To assign an issue, use field_name=\"assignee\" with the assignee email/username as value.",
                "operationId": "update_issue_field_api_issue__issue_key__field_put",
                "parameters": [
                    {
                        "name": "issue_key",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Issue Key"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdateFieldRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "additionalProperties": true,
                                    "title": "Response Update Issue Field Api Issue  Issue Key  Field Put"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/issue/{issue_key}/attachments": {
            "get": {
                "summary": "Get Issue Attachments",
                "description": "Get attachments for an issue.\n\nArgs:\n    issue_key: JIRA issue key (e.g., \"AS-5\")\n\nReturns:\n    Dictionary with list of attachments, each containing id, filename, size, mimeType, content URL, etc.",
                "operationId": "get_issue_attachments_api_issue__issue_key__attachments_get",
                "parameters": [
                    {
                        "name": "issue_key",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Issue Key"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "additionalProperties": true,
                                    "title": "Response Get Issue Attachments Api Issue  Issue Key  Attachments Get"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/attachment/{attachment_id}": {
            "get": {
                "summary": "Download Attachment",
                "description": "Download an attachment from JIRA.\n\nUses authenticated JIRA session to download the attachment file.\nReturns base64-encoded content for MCP compatibility.\n\nArgs:\n    attachment_id: JIRA attachment ID (e.g., \"10036\")\n\nReturns:\n    Dictionary with base64-encoded file content, filename, and content_type\n\nRaises:\n    HTTPException: If attachment not found or download fails",
                "operationId": "download_attachment_api_attachment__attachment_id__get",
                "parameters": [
                    {
                        "name": "attachment_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Attachment Id"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "additionalProperties": true,
                                    "title": "Response Download Attachment Api Attachment  Attachment Id  Get"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "HTTPValidationError": {
                "properties": {
                    "detail": {
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        },
                        "type": "array",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "title": "HTTPValidationError"
            },
            "UpdateFieldRequest": {
                "properties": {
                    "field_name": {
                        "type": "string",
                        "title": "Field Name"
                    },
                    "value": {
                        "type": "string",
                        "title": "Value"
                    }
                },
                "type": "object",
                "required": [
                    "field_name",
                    "value"
                ],
                "title": "UpdateFieldRequest",
                "description": "Request model for updating an issue field."
            },
            "ValidationError": {
                "properties": {
                    "loc": {
                        "items": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "integer"
                                }
                            ]
                        },
                        "type": "array",
                        "title": "Location"
                    },
                    "msg": {
                        "type": "string",
                        "title": "Message"
                    },
                    "type": {
                        "type": "string",
                        "title": "Error Type"
                    }
                },
                "type": "object",
                "required": [
                    "loc",
                    "msg",
                    "type"
                ],
                "title": "ValidationError"
            }
        }
    }
}